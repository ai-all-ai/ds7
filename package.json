  "scripts": {
    "test": "node bin/ds7.js --version && node bin/ds7.js --help > /dev/null && node --test test/integration.test.mjs",
    "format": "npx --yes prettier@3.6.2 --write \"**/*.{js,mjs,cjs,ts,vue,json,yml,yaml}\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"**/*.{js,mjs,cjs,ts,vue,json,yml,yaml}\"",
    "prepublishOnly": "npm test"
  }
}
